# .entrc -- team settings for git-ent.
# Copy to .entrc in the default branch worktree (main/core/.entrc) and commit it
# on the default branch; git-ent reads it from there (git show main:.entrc), so it
# is the same file from every worktree. Lines are key = value. Blank lines and
# # comments are ignored. The file is parsed, never sourced.

# Branch names must match this extended regex. Absent or empty = no rule.
# Never applied to twigs (their names are derived from the parent).
branchPattern = ^(contributor/)?(feature|defect)/[A-Za-z0-9._-]+$

# Maximum depth for nested twigs. Default is 2 (parent -> twig -> twig-of-twig).
# Increase only if your Windows paths stay well under MAX_PATH after
# node_modules, obj/Debug/, etc. stack on top.
# maxDepth = 2

# Extra branches `ent rm` refuses to remove, space-separated.
# The default branch is always protected; this list only adds to it.
protect = integration release
