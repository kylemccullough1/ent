#!/usr/bin/env bash
# git-ent: a git worktree per branch, arranged as nested folders.
#
#   <ent>/.bare/                       the git database (a bare repo)
#   <ent>/.git                         one line: "gitdir: ./.bare"
#   <ent>/main/core/                   the default branch
#   <ent>/branches/<branch>/core/      a branch
#   <container>/twigs/<name>/core/     a twig (a branch nested under a branch or twig)
#
# This file only finds the library and dispatches; each verb lives in lib/cmd/<verb>.sh.
# Runs on bash 3.2+ (stock macOS, Linux, Git Bash on Windows).
set -euo pipefail

VERSION=0.4.0

# The library sits next to this script in a checkout, or in the install location.
# Follow symlinks first, so `ln -s ~/src/ent/git-ent ~/bin/` finds ~/src/ent/lib.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" == /* ]] || _self="$_dir/$_self"
done
ENT_LIB="$(cd "$(dirname "$_self")" && pwd)/lib"
unset _self _dir
[[ -d "$ENT_LIB" ]] || ENT_LIB="${XDG_DATA_HOME:-$HOME/.local/share}/git-ent/lib"
for _f in output args run prompt log tree state paths config view wt; do source "$ENT_LIB/$_f.sh"; done
for _f in "$ENT_LIB"/cmd/*.sh; do source "$_f"; done
unset _f

# ensure_ent: find the ent around the current folder and read its git state once.
ensure_ent() {
  ENT="$(ent_root)" || die "not inside an ent (no .bare found). See: ent help init"
  load_state
}

# Verbs in the order `ent help` lists them.
VERBS="init branch merge twig track list status log go up down open path sync rm destroy"

# Verbs that end at a folder, so --tab / --new-window can open it in Windows Terminal.
OPEN_VERBS="init branch merge twig go up down open"

cmd_help() {
  local v="${1:-}"
  if [[ -n "$v" ]]; then
    declare -f "help_$v" >/dev/null || die "no help for '$v'"
    "help_$v"; return
  fi
  echo "git ent $VERSION: a git worktree per branch, as nested folders"
  echo
  echo "Usage: ent <verb> [args]      (\`ent help <verb>\` for details)"
  echo
  for v in $VERBS; do "help_$v" | head -n 1 | sed 's/^/  /'; done
  echo
  echo "Global flags: -n/--dry-run  -v/--verbose  -q/--quiet  -y/--yes  -h/--help  --version"
  echo "Open flags:   --tab  --new-window   (init, branch, branch merge, twig, go, up, down, open)"
}

# open_preflight <verb>: `open` means a new tab unless --new-window says otherwise.
# With a mode set, refuse verbs that have no folder to open, then make sure Windows
# Terminal is there before the verb changes anything: `ent branch x --tab` without WT
# must fail before the branch exists, not after.
open_preflight() {
  if [[ "$1" == open && -z "$OPEN_MODE" ]]; then OPEN_MODE=tab; fi
  [[ -n "$OPEN_MODE" ]] || return 0
  case " $OPEN_VERBS " in
    *" $1 "*) ;;
    *) die "--tab and --new-window only apply to: $OPEN_VERBS" ;;
  esac
  wt_require
}

main() {
  parse_globals "$@"
  local verb; verb="$(arg 0)"
  # `branch merge` is its own verb for help and dispatch
  if [[ "$verb" == branch && "$(arg 1)" == merge ]]; then verb=merge; fi
  if [[ -z "$verb" ]]; then cmd_help; exit 1; fi
  if (( HELP )); then cmd_help "$verb"; exit 0; fi
  open_preflight "$verb"
  case "$verb" in
    help)    cmd_help "$(arg 1)" ;;
    init|branch|merge|twig|track|list|status|log|go|up|down|open|path|sync|rm|destroy) "cmd_$verb" ;;
    __where) cmd_where ;;   # internal: used by the shell prompt helpers
    *)       die "unknown verb: $verb" ;;
  esac
}

main "$@"
